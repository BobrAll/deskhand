{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron.vite.config.ts",
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/{overlay,pointer,cursor,hud,settings,onboarding}/index.html",
    "src/renderer/{overlay,pointer,cursor,hud,settings,onboarding}/main.ts*",
    "scripts/*.mjs"
