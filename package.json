{
  "name": "deskhand",
  "version": "0.1.0",
  "description": "Deskhand — контекстный AI-ассистент для macOS",
  "main": "./out/main/index.js",
  "author": "Alexander Bobrus",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-speech.mjs && electron-vite dev",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "build": "node scripts/prepare-speech.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:helper": "node scripts/build-helper.mjs",
    "build:whisper": "node scripts/build-whisper.mjs",
    "build:transcribe": "node scripts/build-transcribe.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "build:native": "npm run build:helper && npm run build:whisper && npm run build:agent",
    "pack": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac && node scripts/prepare-release.mjs",
    "sign:cert": "bash scripts/create-signing-cert.sh",
    "agent:report": "node scripts/agent-trace-report.mjs",
    "agent:timeline": "node scripts/agent-trace-report.mjs --timeline",
    "test:native": "node scripts/test-native.mjs",
    "lint": "eslint src",
    "worktree": "node scripts/preview-worktree.mjs"
  },
  "build": {
    "appId": "com.bobr.deskhand",
    "productName": "Deskhand",
    "copyright": "© 2026 Alexander Bobrus",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/whisper-licenses",
        "to": "whisper-licenses"
      },
      {
        "from": "resources/deskhand-helper",
        "to": "deskhand-helper"
      },
      {
        "from": "resources/whisper-cli",
        "to": "whisper-cli"
      },
      {
        "from": "resources/deskhand-agent",
        "to": "deskhand-agent"
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "transcribe-cli",
          "transcribe-licenses/**",
          "speech/gigaam-v3-e2e-rnnt-Q4_K_M.gguf",
          "speech/GigaAM-LICENSE.txt"
        ]
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "14.0",
      "artifactName": "Deskhand-${arch}.${ext}",
      "x64ArchFiles": "Contents/Resources/{deskhand-helper,whisper-cli,transcribe-cli,deskhand-agent}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Deskhand управляет другими приложениями, чтобы читать выделенный текст и вставлять ответ.",
        "NSMicrophoneUsageDescription": "Deskhand записывает голос, пока ты удерживаешь клавишу, и распознаёт его локально — звук не покидает Mac.",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    }
  },
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "eslint": "9.39.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.10",
    "vitest": "^2.1.9"
  }
}
