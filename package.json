{
  "name": "smart-cursor",
  "version": "0.1.0",
  "description": "Умный курсор — контекстный AI-ассистент для macOS",
  "main": "./out/main/index.js",
  "author": "Alexander Bobrus",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:helper": "node scripts/build-helper.mjs",
    "build:whisper": "node scripts/build-whisper.mjs",
    "build:transcribe": "node scripts/build-transcribe.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "pack": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "agent:report": "node scripts/agent-trace-report.mjs",
    "agent:timeline": "node scripts/agent-trace-report.mjs --timeline",
    "test:native": "node scripts/test-native.mjs",
    "lint": "eslint src"
  },
  "build": {
    "appId": "com.bobr.smartcursor",
    "productName": "Smart Cursor",
    "copyright": "© 2026 Alexander Bobrus",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/smartcursor-helper",
        "to": "smartcursor-helper"
      },
      {
        "from": "resources/whisper-cli",
        "to": "whisper-cli"
      },
      {
        "from": "resources/deskhand-agent",
        "to": "deskhand-agent"
      },
      {
        "from": "resources",
        "to": ".",
        "filter": ["transcribe-cli", "transcribe-licenses/**"]
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "x64ArchFiles": "Contents/Resources/{smartcursor-helper,whisper-cli,transcribe-cli,deskhand-agent}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Smart Cursor управляет другими приложениями, чтобы читать выделенный текст и вставлять ответ.",
        "NSMicrophoneUsageDescription": "Smart Cursor записывает голос, пока вы удерживаете клавишу, и распознаёт его локально — звук не покидает Mac.",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Smart Cursor",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "eslint": "9.39.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.10",
    "vitest": "^2.1.9"
  }
}
